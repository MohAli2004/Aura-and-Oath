APP_NAME="Aura & Oath"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB recommended for local + production)
# For quick SQLite: DB_CONNECTION=sqlite and comment out the rest.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auraandoath
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production so the session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ---------------------------------------------------------------------------
# Mail (required for contact form delivery to AURA_CONTACT_EMAIL)
# ---------------------------------------------------------------------------
# Practical path for Gmail: smtp.gmail.com:587 with STARTTLS (MAIL_SCHEME=null).
# Create a Gmail App Password (not your normal login password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Paste the 16-character app password with NO spaces (or leave spaces; config strips them).
# Do not use your normal Gmail login password — SMTP will return 535 BadCredentials.
# Dev-only without SMTP: MAIL_MAILER=log writes messages to storage/logs instead of sending.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=auraandouth@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="auraandouth@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google OAuth (Gmail sign-in) — Google Cloud Console > APIs & Services > Credentials
# Create an OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------------------------------------------------------------------------
# Aura & Oath brand / commerce settings (see config/aura.php)
# ---------------------------------------------------------------------------
AURA_BRAND_NAME="Aura & Oath"
AURA_TAGLINE="Beauty, body care, and home — quietly confident."
AURA_CURRENCY=USD
AURA_CURRENCY_SYMBOL=$
AURA_LOCALE=en_US
AURA_COUNTRY=LB
AURA_COUNTRY_NAME=Lebanon
AURA_CONTACT_EMAIL=auraandouth@gmail.com
AURA_CONTACT_PHONE="+961 81 031 612"
# Public display of the store phone is off by default. Toggle it in Admin → Control panel.
AURA_WHATSAPP="+96181031612"
AURA_ADDRESS="Beirut, Lebanon"
AURA_SUPPORT_HOURS="Mon–Fri, 10:00–18:00"
AURA_WISH_ACCOUNT_NAME="Aura & Oath"
AURA_WISH_ACCOUNT_NUMBER="81031612"
AURA_WISH_INSTRUCTIONS="Send the order total to our Wish account, then include your order number in the transfer note. We will confirm payment before preparing your order."

# Whish Pay (official gateway) — fill when you have merchant credentials
WHISH_ENABLED=false
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL="${APP_URL}"
WHISH_ENVIRONMENT=sandbox

# WhatsApp Cloud API — notify admin when Wish payment succeeds
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

AURA_INSTAGRAM=https://instagram.com/auraandoath
AURA_FACEBOOK=https://facebook.com/auraandoath
AURA_TIKTOK=https://tiktok.com/@auraandoath
AURA_YOUTUBE=

# Seeded admin. Production seeding fails unless this is set to 12+ characters.
AURA_ADMIN_EMAIL=admin@auraandoath.com
AURA_ADMIN_PASSWORD=
AURA_ADMIN_NAME="Aura Admin"

# ---------------------------------------------------------------------------
# Web Push (browser alerts while the user is away from the site)
# Generate keys: php artisan webpush:vapid
# Requires HTTPS in production (localhost is fine for local testing).
# ---------------------------------------------------------------------------
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Response headers (CSP, HSTS, frame/sniff/referrer). Turn CSP to report-only
# first if you add third-party scripts and want to watch for breakage.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_PRELOAD=false
# Comma separated extra origins if you ever embed third-party scripts/frames.
SECURITY_EXTRA_SCRIPT_SRC=
SECURITY_EXTRA_CONNECT_SRC=
SECURITY_EXTRA_FRAME_SRC=

# Leave unset to follow APP_URL. Set true when behind a TLS-terminating proxy.
# FORCE_HTTPS=true
# Narrow this to your load balancer IPs if you have them.
TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# Production checklist (do not copy the local values above)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# AURA_ADMIN_PASSWORD=<long random value>
# php artisan config:cache && php artisan route:cache && php artisan view:cache

# Optional: Google Search Console site verification meta tag
# GOOGLE_SITE_VERIFICATION=
